{
  "name": "@feniix/backlog-ranker",
  "version": "0.1.3",
  "description": "Rank, calibrate and explain a backlog with a rubric and a decision model",
  "license": "MIT",
  "author": "Sebastian Otaegui",
  "contributors": [
    {
      "name": "Spantree Technology Group, LLC",
      "url": "https://spantree.net"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spantree/backlog-ranker.git"
  },
  "bugs": {
    "url": "https://github.com/Spantree/backlog-ranker/issues"
  },
  "homepage": "https://github.com/Spantree/backlog-ranker#readme",
  "type": "module",
  "bin": {
    "backlog-ranker": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "rubrics",
    "skills",
    "docs",
    "!docs/agents",
    "README.md",
    "LICENSE",
    "ROADMAP.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.5",
    "@typesafe-ai/sdk": "^0.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22",
    "bun-types": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
